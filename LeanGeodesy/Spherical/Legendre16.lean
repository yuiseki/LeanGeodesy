import LeanGeodesy.Spherical.Legendre12

/-!
# Legendre polynomials `P₀..P₁₆` and Chebyshev-basis Bachoc–Vallentin bound on `S²`

This module extends `Legendre12.lean` to `P₁₃, P₁₄, P₁₅, P₁₆` via the same `bvQ`
addition theorem, and provides `bachocVallentin_cheb_bound_with_legendre16`, which
parameterizes the three-point kernel matrices `F_k` in the Chebyshev basis `T_i(u) T_j(v)`
for improved numerical conditioning at degree `d₃ = 8, d₂ = 16`.
-/

namespace Geodesy.Spherical

set_option maxRecDepth 4000

open scoped BigOperators RealInnerProductSpace

/-- Chebyshev polynomials of the first kind `T_k(t)`. -/
def chebT : ℕ → ℝ → ℝ
  | 0, _ => 1
  | 1, t => t
  | k + 2, t => 2 * t * chebT (k + 1) t - chebT k t

/-- Every Chebyshev polynomial evaluates to `1` at `t = 1`. -/
theorem chebT_one : ∀ k : ℕ, chebT k 1 = 1
  | 0 => rfl
  | 1 => rfl
  | k + 2 => by
    simp only [chebT, chebT_one (k + 1), chebT_one k]
    ring

/-- Explicit Legendre polynomials `P_k(t)` for `0 ≤ k ≤ 16` (and `0` for `k > 16`). -/
noncomputable def legendreP16 : ℕ → ℝ → ℝ
  | 0, t => legendreP12 0 t
  | 1, t => legendreP12 1 t
  | 2, t => legendreP12 2 t
  | 3, t => legendreP12 3 t
  | 4, t => legendreP12 4 t
  | 5, t => legendreP12 5 t
  | 6, t => legendreP12 6 t
  | 7, t => legendreP12 7 t
  | 8, t => legendreP12 8 t
  | 9, t => legendreP12 9 t
  | 10, t => legendreP12 10 t
  | 11, t => legendreP12 11 t
  | 12, t => legendreP12 12 t
  | 13, t => (1300075 / 1024 : ℝ) * t ^ 13 + (-2028117 / 512 : ℝ) * t ^ 11 + (4849845 / 1024 : ℝ) * t ^ 9 + (-692835 / 256 : ℝ) * t ^ 7 + (765765 / 1024 : ℝ) * t ^ 5 + (-45045 / 512 : ℝ) * t ^ 3 + (3003 / 1024 : ℝ) * t
  | 14, t => (5014575 / 2048 : ℝ) * t ^ 14 + (-16900975 / 2048 : ℝ) * t ^ 12 + (22309287 / 2048 : ℝ) * t ^ 10 + (-14549535 / 2048 : ℝ) * t ^ 8 + (4849845 / 2048 : ℝ) * t ^ 6 + (-765765 / 2048 : ℝ) * t ^ 4 + (45045 / 2048 : ℝ) * t ^ 2 + (-429 / 2048 : ℝ)
  | 15, t => (9694845 / 2048 : ℝ) * t ^ 15 + (-35102025 / 2048 : ℝ) * t ^ 13 + (50702925 / 2048 : ℝ) * t ^ 11 + (-37182145 / 2048 : ℝ) * t ^ 9 + (14549535 / 2048 : ℝ) * t ^ 7 + (-2909907 / 2048 : ℝ) * t ^ 5 + (255255 / 2048 : ℝ) * t ^ 3 + (-6435 / 2048 : ℝ) * t
  | 16, t => (300540195 / 32768 : ℝ) * t ^ 16 + (-145422675 / 4096 : ℝ) * t ^ 14 + (456326325 / 8192 : ℝ) * t ^ 12 + (-185910725 / 4096 : ℝ) * t ^ 10 + (334639305 / 16384 : ℝ) * t ^ 8 + (-20369349 / 4096 : ℝ) * t ^ 6 + (4849845 / 8192 : ℝ) * t ^ 4 + (-109395 / 4096 : ℝ) * t ^ 2 + (6435 / 32768 : ℝ)
  | _, _ => 0

/-- Every `legendreP16 k` evaluates to `1` at `t = 1` for `k ≤ 16`. -/
theorem legendreP16_one {k : ℕ} (hk : k ≤ 16) : legendreP16 k 1 = 1 := by
  interval_cases k
  · simp only [legendreP16]; exact legendreP12_one (by omega)
  · simp only [legendreP16]; exact legendreP12_one (by omega)
  · simp only [legendreP16]; exact legendreP12_one (by omega)
