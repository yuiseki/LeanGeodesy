/-- Positive semidefiniteness of `legendreP16 k` on `S²` for all `k ≤ 16`. -/
theorem sum_legendreP16_nonneg {n : ℕ} (p : Fin n → UnitSphere) {k : ℕ} (hk : k ≤ 16) :
    0 ≤ ∑ i : Fin n, ∑ j : Fin n, legendreP16 k ⟪(p i).val, (p j).val⟫ := by
  by_cases h12 : k ≤ 12
  · have hEq : ∀ t : ℝ, legendreP16 k t = legendreP12 k t := by
      intro t
      interval_cases k <;> rfl
    simp_rw [hEq]
    exact sum_legendreP12_nonneg p h12
  · have hk' : k = 13 ∨ k = 14 ∨ k = 15 ∨ k = 16 := by omega
    rcases hk' with rfl | rfl | rfl | rfl
    · exact sum_legendreP16_nonneg_13 p
    · exact sum_legendreP16_nonneg_14 p
    · exact sum_legendreP16_nonneg_15 p
    · exact sum_legendreP16_nonneg_16 p

/-- Positive semidefiniteness of a Chebyshev-weighted triple sum with `bvQ k`. -/
theorem sum_triple_cheb_bvQ_nonneg {n m : ℕ} (p : Fin n → UnitSphere) (k : ℕ)
    (F : Matrix (Fin m) (Fin m) ℝ) (hF : F.PosSemidef) :
    0 ≤ ∑ x : Fin n, ∑ y : Fin n, ∑ z : Fin n,
      (∑ i : Fin m, ∑ j : Fin m,
        F i j * chebT i.val ⟪(p x).val, (p y).val⟫ * chebT j.val ⟪(p x).val, (p z).val⟫) *
        bvQ k ⟪(p x).val, (p y).val⟫ ⟪(p x).val, (p z).val⟫ ⟪(p y).val, (p z).val⟫ := by
  refine Finset.sum_nonneg fun x _ => ?_
  obtain ⟨e₁, e₂, hframe⟩ := exists_tangent_frame (p x)
  let w : Fin n → ℂ := fun i => ⟨inner ℝ (p i).1 e₁, inner ℝ (p i).1 e₂⟩
  let zR : Fin m → ℝ := fun a => ∑ i : Fin n, chebT a.val ⟪(p x).val, (p i).val⟫ * ((w i) ^ k).re
  let zI : Fin m → ℝ := fun a => ∑ i : Fin n, chebT a.val ⟪(p x).val, (p i).val⟫ * ((w i) ^ k).im
  have hR : 0 ≤ ∑ a : Fin m, ∑ b : Fin m, zR a * F a b * zR b := posSemidef_quad_nonneg hF zR
  have hI : 0 ≤ ∑ a : Fin m, ∑ b : Fin m, zI a * F a b * zI b := posSemidef_quad_nonneg hF zI
  have heq :
      (∑ y : Fin n, ∑ z : Fin n,
        (∑ a : Fin m, ∑ b : Fin m,
          F a b * chebT a.val ⟪(p x).val, (p y).val⟫ * chebT b.val ⟪(p x).val, (p z).val⟫) *
          bvQ k ⟪(p x).val, (p y).val⟫ ⟪(p x).val, (p z).val⟫ ⟪(p y).val, (p z).val⟫) =
      (∑ a : Fin m, ∑ b : Fin m, zR a * F a b * zR b) +
      (∑ a : Fin m, ∑ b : Fin m, zI a * F a b * zI b) := by
    have hre : ∀ y z : Fin n,
        bvQ k ⟪(p x).val, (p y).val⟫ ⟪(p x).val, (p z).val⟫ ⟪(p y).val, (p z).val⟫ =
          ((w y) ^ k).re * ((w z) ^ k).re + ((w y) ^ k).im * ((w z) ^ k).im := fun y z => by
      have h := bvQ_eq_re_complex (p x) (p y) (p z) e₁ e₂ hframe k
      simp only [w, Complex.mul_re, Complex.star_def, Complex.conj_re, Complex.conj_im] at h ⊢
      linarith
    have hpush : ∀ y z : Fin n,
        (∑ a : Fin m, ∑ b : Fin m,
          F a b * chebT a.val ⟪(p x).val, (p y).val⟫ * chebT b.val ⟪(p x).val, (p z).val⟫) *
          bvQ k ⟪(p x).val, (p y).val⟫ ⟪(p x).val, (p z).val⟫ ⟪(p y).val, (p z).val⟫ =
        ∑ a : Fin m, ∑ b : Fin m,
          ((chebT a.val ⟪(p x).val, (p y).val⟫ * ((w y) ^ k).re) * F a b *
            (chebT b.val ⟪(p x).val, (p z).val⟫ * ((w z) ^ k).re) +
           (chebT a.val ⟪(p x).val, (p y).val⟫ * ((w y) ^ k).im) * F a b *
            (chebT b.val ⟪(p x).val, (p z).val⟫ * ((w z) ^ k).im)) := by
      intro y z
      rw [hre y z, Finset.sum_mul]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun b _ => by ring
    simp_rw [hpush]
    have hswap : ∀ f : Fin m → Fin m → Fin n → Fin n → ℝ,
        (∑ y : Fin n, ∑ z : Fin n, ∑ a : Fin m, ∑ b : Fin m, f a b y z) =
        ∑ a : Fin m, ∑ b : Fin m, ∑ y : Fin n, ∑ z : Fin n, f a b y z := fun f => by
      calc _ = ∑ y : Fin n, ∑ a : Fin m, ∑ z : Fin n, ∑ b : Fin m, f a b y z :=
              Finset.sum_congr rfl fun _ _ => Finset.sum_comm
        _ = ∑ a : Fin m, ∑ y : Fin n, ∑ z : Fin n, ∑ b : Fin m, f a b y z := Finset.sum_comm
        _ = ∑ a : Fin m, ∑ y : Fin n, ∑ b : Fin m, ∑ z : Fin n, f a b y z :=
              Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_comm
        _ = ∑ a : Fin m, ∑ b : Fin m, ∑ y : Fin n, ∑ z : Fin n, f a b y z :=
              Finset.sum_congr rfl fun _ _ => Finset.sum_comm
    rw [hswap]
    simp_rw [Finset.sum_add_distrib]
    congr 1
    · refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
      simp only [zR, Finset.sum_mul, Finset.mul_sum]; rw [Finset.sum_comm]
    · refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
      simp only [zI, Finset.sum_mul, Finset.mul_sum]; rw [Finset.sum_comm]
  rw [heq]
  exact add_nonneg hR hI

/-- Unsymmetrized Chebyshev-basis three-point kernel polynomial `G₃(u, v, t)`. -/
noncomputable def bvChebG3Unaug {d : ℕ}
    (F : (k : Fin (d + 1)) → Matrix (Fin (d - k.val + 1)) (Fin (d - k.val + 1)) ℝ)
    (u v t : ℝ) : ℝ :=
  ∑ k : Fin (d + 1),
    (∑ i : Fin (d - k.val + 1), ∑ j : Fin (d - k.val + 1),
      F k i j * chebT i.val u * chebT j.val v) * bvQ k.val u v t

/-- Associated two-point univariate polynomial `G₂(t)` in the Chebyshev basis. -/
noncomputable def bvChebG2Unaug {d : ℕ}
    (F : (k : Fin (d + 1)) → Matrix (Fin (d - k.val + 1)) (Fin (d - k.val + 1)) ℝ)
    (t : ℝ) : ℝ :=
  2 * (∑ i : Fin (d + 1), ∑ j : Fin (d + 1), F ⟨0, Nat.zero_lt_succ d⟩ i j * chebT i.val t) +
  ∑ k : Fin (d + 1),
    (∑ i : Fin (d - k.val + 1), ∑ j : Fin (d - k.val + 1),
      F k i j * chebT i.val t * chebT j.val t) * (1 - t ^ 2) ^ k.val

/-- Combined Chebyshev-basis Bachoc–Vallentin three-point SDP + two-point Legendre
(`P₁..P₁₆`) upper bound for spherical codes on `S²`. -/
private theorem bvQ_one_left16 : ∀ k : ℕ, k ≠ 0 → ∀ t : ℝ, bvQ k 1 t t = 0 := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    match k with
    | 0 => intro h; exact absurd rfl h
    | 1 => intro _ t; simp [bvQ]
    | k + 2 =>
      intro _ t
      rw [bvQ_succ_succ, ih (k + 1) (by omega) (by omega) t]
      ring

private theorem bvQ_one_mid16 : ∀ k : ℕ, k ≠ 0 → ∀ t : ℝ, bvQ k t 1 t = 0 := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    match k with
    | 0 => intro h; exact absurd rfl h
    | 1 => intro _ t; simp [bvQ]
    | k + 2 =>
      intro _ t
      rw [bvQ_succ_succ, ih (k + 1) (by omega) (by omega) t]
      ring

theorem bachocVallentin_cheb_bound_with_legendre16 {d n : ℕ} {s : ℝ} {p : Fin n → UnitSphere}
    (F : (k : Fin (d + 1)) → Matrix (Fin (d - k.val + 1)) (Fin (d - k.val + 1)) ℝ)
    (hF : ∀ k, (F k).PosSemidef)
    (c2 : Fin 16 → ℝ) (hc2 : ∀ k, 0 ≤ c2 k)
    (h2 : ∀ t, -1 ≤ t → t ≤ s →
      bvChebG2Unaug F t + ∑ k : Fin 16, c2 k * legendreP16 (k.val + 1) t ≤ -1)
    (h3 : ∀ u v t, InThreePointDomain s u v t → sym3 (bvChebG3Unaug F) u v t ≤ 0)
    (hp : IsSphericalCode p s) :
    (n : ℝ) ≤ 1 + (∑ i : Fin (d + 1), ∑ j : Fin (d + 1), F ⟨0, Nat.zero_lt_succ d⟩ i j) +
      ∑ k : Fin 16, c2 k := by
  by_cases hn : n = 0
  · subst hn
    have hdiag_nn : 0 ≤ ∑ i : Fin (d + 1), ∑ j : Fin (d + 1), F ⟨0, Nat.zero_lt_succ d⟩ i j := by
      have h := posSemidef_quad_nonneg (hF ⟨0, Nat.zero_lt_succ d⟩) (fun _ => (1 : ℝ))
      simpa using h
    have hc2_nn : 0 ≤ ∑ k : Fin 16, c2 k := Finset.sum_nonneg fun k _ => hc2 k
    simp only [Nat.cast_zero]; linarith
  have hn_pos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn)
  let f3 : Fin n → Fin n → Fin n → ℝ := fun x y z =>
    bvChebG3Unaug F ⟪(p x).val, (p y).val⟫ ⟪(p x).val, (p z).val⟫ ⟪(p y).val, (p z).val⟫
  have hS3 : 0 ≤ ∑ x : Fin n, ∑ y : Fin n, ∑ z : Fin n, f3 x y z := by
    have hswap : ∑ k : Fin (d + 1), ∑ x : Fin n, ∑ y : Fin n, ∑ z : Fin n,
          (∑ i : Fin (d - k.val + 1), ∑ j : Fin (d - k.val + 1),
            F k i j * chebT i.val ⟪(p x).val, (p y).val⟫ * chebT j.val ⟪(p x).val, (p z).val⟫) *
            bvQ k.val ⟪(p x).val, (p y).val⟫ ⟪(p x).val, (p z).val⟫ ⟪(p y).val, (p z).val⟫ =
        ∑ x : Fin n, ∑ y : Fin n, ∑ z : Fin n, f3 x y z := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun x _ => ?_
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun y _ => ?_
      rw [Finset.sum_comm]
      rfl
    rw [← hswap]
    exact Finset.sum_nonneg fun k _ => sum_triple_cheb_bvQ_nonneg p k.val (F k) (hF k)
  have hS2 : 0 ≤ ∑ k : Fin 16, c2 k * (∑ x : Fin n, ∑ y : Fin n, legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫) :=
    Finset.sum_nonneg fun k _ => mul_nonneg (hc2 k) (sum_legendreP16_nonneg p (by omega))
  have hS2_split :
      ∑ k : Fin 16, c2 k * (∑ x : Fin n, ∑ y : Fin n, legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫) =
      (n : ℝ) * (∑ k : Fin 16, c2 k) +
      ∑ x : Fin n, ∑ y : Fin n,
        if x ≠ y then ∑ k : Fin 16, c2 k * legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫ else 0 := by
    have h1 : ∀ k : Fin 16,
        ∑ x : Fin n, ∑ y : Fin n, legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫ =
        (n : ℝ) + ∑ x : Fin n, ∑ y : Fin n,
          if x ≠ y then legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫ else 0 := by
      intro k
      have hsplit : ∀ x : Fin n,
          ∑ y : Fin n, legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫ =
          1 + ∑ y : Fin n, if x ≠ y then legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫ else 0 := by
        intro x
        have hdiag_y : legendreP16 (k.val + 1) ⟪(p x).val, (p x).val⟫ = 1 := by
          rw [Geodesic.inner_self_of_norm_one (p x).2]
          exact legendreP16_one (by omega)
        have h2' := Finset.add_sum_erase (Finset.univ : Finset (Fin n))
          (fun y => legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫) (Finset.mem_univ x)
        have h3' := Finset.add_sum_erase (Finset.univ : Finset (Fin n))
          (fun y => if x ≠ y then legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫ else 0) (Finset.mem_univ x)
        simp only [ne_eq, not_true_eq_false, ↓reduceIte, zero_add] at h3'
        have hcongr : ∑ y ∈ Finset.univ.erase x,
            (if x ≠ y then legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫ else 0) =
            ∑ y ∈ Finset.univ.erase x, legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫ :=
          Finset.sum_congr rfl fun y hy => by simp [(Finset.mem_erase.mp hy).1.symm]
        rw [← h2', hdiag_y, ← h3', hcongr]
      simp_rw [hsplit, Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
        nsmul_eq_mul, mul_one]
    simp_rw [h1, mul_add, Finset.sum_add_distrib]
    congr 1
    · rw [Finset.mul_sum]; refine Finset.sum_congr rfl fun k _ => by ring
    · simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun x _ => ?_
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun y _ => ?_
      by_cases hxy : x ≠ y <;> simp [hxy]
  have hS3_split : ∑ x : Fin n, ∑ y : Fin n, ∑ z : Fin n, f3 x y z =
      (∑ x : Fin n, f3 x x x) +
      (∑ x : Fin n, ∑ y : Fin n, if x ≠ y then f3 x x y + f3 x y x + f3 x y y else 0) +
      (∑ x : Fin n, ∑ y ∈ Finset.univ.erase x, ∑ z ∈ (Finset.univ.erase x).erase y, f3 x y z) := by
    have hinner : ∀ x : Fin n,
        ∑ y : Fin n, ∑ z : Fin n, f3 x y z =
        f3 x x x +
        (∑ y ∈ Finset.univ.erase x, (f3 x x y + f3 x y x + f3 x y y)) +
        (∑ y ∈ Finset.univ.erase x, ∑ z ∈ (Finset.univ.erase x).erase y, f3 x y z) := by
      intro x
      have hy := (Finset.add_sum_erase (Finset.univ : Finset (Fin n))
        (fun y => ∑ z : Fin n, f3 x y z) (Finset.mem_univ x)).symm
      rw [hy]
      have hz0 := (Finset.add_sum_erase (Finset.univ : Finset (Fin n))
        (fun z => f3 x x z) (Finset.mem_univ x)).symm
      rw [hz0]
      have hzy : ∀ y ∈ Finset.univ.erase x,
          ∑ z : Fin n, f3 x y z =
          f3 x y x + f3 x y y + ∑ z ∈ (Finset.univ.erase x).erase y, f3 x y z := by
        intro y hy
        have h1 := (Finset.add_sum_erase (Finset.univ : Finset (Fin n))
          (fun z => f3 x y z) (Finset.mem_univ x)).symm
        have h2 := (Finset.add_sum_erase (Finset.univ.erase x)
          (fun z => f3 x y z) hy).symm
        rw [h1, h2]; ring
      rw [Finset.sum_congr rfl hzy]
      simp only [Finset.sum_add_distrib]
      ring
    simp_rw [hinner, Finset.sum_add_distrib]
    congr 1; congr 1
    simp only [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun x _ => ?_
    rw [← Finset.sum_filter]
    refine Finset.sum_congr ?_ (fun _ _ => rfl)
    ext y; simp [ne_comm]
  rw [hS3_split] at hS3
  have hdiag : ∑ x : Fin n, f3 x x x =
      (n : ℝ) * (∑ i : Fin (d + 1), ∑ j : Fin (d + 1), F ⟨0, Nat.zero_lt_succ d⟩ i j) := by
    have hxx : ∀ x : Fin n,
        f3 x x x = ∑ i : Fin (d + 1), ∑ j : Fin (d + 1), F ⟨0, Nat.zero_lt_succ d⟩ i j := by
      intro x
      simp only [f3, bvChebG3Unaug, Geodesic.inner_self_of_norm_one (p x).2, chebT_one, mul_one]
      rw [Finset.sum_eq_single ⟨0, Nat.zero_lt_succ d⟩]
      · simp [bvQ]
      · intro k _ hk
        have hk0 : k.val ≠ 0 := fun h => hk (Fin.ext h)
        simp [bvQ_one_left16 k.val hk0]
      · intro h; exact absurd (Finset.mem_univ _) h
    simp_rw [hxx, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hpair : ∀ x y : Fin n,
      f3 x x y + f3 x y x + f3 x y y = bvChebG2Unaug F ⟪(p x).val, (p y).val⟫ := by
    intro x y
    set t := ⟪(p x).val, (p y).val⟫
    have hxy : ⟪(p y).val, (p x).val⟫ = t := real_inner_comm _ _
    have h1 : f3 x x y = ∑ i : Fin (d + 1), ∑ j : Fin (d + 1),
        F ⟨0, Nat.zero_lt_succ d⟩ i j * chebT j.val t := by
      simp only [f3, bvChebG3Unaug, Geodesic.inner_self_of_norm_one (p x).2, chebT_one, mul_one]
      rw [Finset.sum_eq_single ⟨0, Nat.zero_lt_succ d⟩]
      · simp [t, bvQ]
      · intro k _ hk
        have hk0 : k.val ≠ 0 := fun h => hk (Fin.ext h)
        simp [bvQ_one_left16 k.val hk0]
      · intro h; exact absurd (Finset.mem_univ _) h
    have h2' : f3 x y x = ∑ i : Fin (d + 1), ∑ j : Fin (d + 1),
        F ⟨0, Nat.zero_lt_succ d⟩ i j * chebT i.val t := by
      simp only [f3, bvChebG3Unaug, Geodesic.inner_self_of_norm_one (p x).2, chebT_one, mul_one, hxy]
      rw [Finset.sum_eq_single ⟨0, Nat.zero_lt_succ d⟩]
      · simp [t, bvQ]
      · intro k _ hk
        have hk0 : k.val ≠ 0 := fun h => hk (Fin.ext h)
        change (∑ i, ∑ j, F k i j * chebT i.val t) * bvQ k.val t 1 t = 0
        simp [bvQ_one_mid16 k.val hk0]
      · intro h; exact absurd (Finset.mem_univ _) h
    have h3' : f3 x y y = ∑ k : Fin (d + 1),
        (∑ i : Fin (d - k.val + 1), ∑ j : Fin (d - k.val + 1),
          F k i j * chebT i.val t * chebT j.val t) * (1 - t ^ 2) ^ k.val := by
      simp only [f3, bvChebG3Unaug, Geodesic.inner_self_of_norm_one (p y).2, bvQ_diag, t]
    have hsym0 : ∑ i : Fin (d + 1), ∑ j : Fin (d + 1),
        F ⟨0, Nat.zero_lt_succ d⟩ i j * chebT j.val t =
        ∑ i : Fin (d + 1), ∑ j : Fin (d + 1),
        F ⟨0, Nat.zero_lt_succ d⟩ i j * chebT i.val t := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      have hH := (hF ⟨0, Nat.zero_lt_succ d⟩).isHermitian
      have hij : F ⟨0, Nat.zero_lt_succ d⟩ j i = F ⟨0, Nat.zero_lt_succ d⟩ i j := by
        have h := congr_fun (congr_fun hH i) j
        change star (F ⟨0, Nat.zero_lt_succ d⟩ j i) = F ⟨0, Nat.zero_lt_succ d⟩ i j at h
        simpa using h
      rw [hij]
    rw [h1, h2', h3', hsym0, bvChebG2Unaug]
    ring
  have htriple : ∑ x : Fin n, ∑ y ∈ Finset.univ.erase x, ∑ z ∈ (Finset.univ.erase x).erase y,
      f3 x y z ≤ 0 := by
    have hsym := sum_distinct_triples_eq_sym3 p (bvChebG3Unaug F)
    rw [hsym]
    refine Finset.sum_nonpos fun x _ => Finset.sum_nonpos fun y hy => Finset.sum_nonpos fun z hz => ?_
    have hxy : x ≠ y := (Finset.mem_erase.mp hy).1.symm
    have hyz : y ≠ z := (Finset.mem_erase.mp hz).1.symm
    have hxz : x ≠ z := (Finset.mem_erase.mp (Finset.mem_erase.mp hz).2).1.symm
    exact h3 _ _ _ (inThreePointDomain_of_isSphericalCode hp hxy hxz hyz)
  have htot : 0 ≤ (n : ℝ) * (∑ i : Fin (d + 1), ∑ j : Fin (d + 1), F ⟨0, Nat.zero_lt_succ d⟩ i j) +
      (n : ℝ) * (∑ k : Fin 16, c2 k) +
      ∑ x : Fin n, ∑ y : Fin n, if x ≠ y then
        (bvChebG2Unaug F ⟪(p x).val, (p y).val⟫ + ∑ k : Fin 16, c2 k * legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫)
      else 0 := by
    rw [hS2_split] at hS2
    have hcomb : (∑ x : Fin n, ∑ y : Fin n, if x ≠ y then f3 x x y + f3 x y x + f3 x y y else 0) +
        (∑ x : Fin n, ∑ y : Fin n, if x ≠ y then ∑ k : Fin 16, c2 k * legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫ else 0) =
        ∑ x : Fin n, ∑ y : Fin n, if x ≠ y then
          (bvChebG2Unaug F ⟪(p x).val, (p y).val⟫ + ∑ k : Fin 16, c2 k * legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫) else 0 := by
      simp_rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun x _ => Finset.sum_congr rfl fun y _ => ?_
      by_cases hxy : x ≠ y <;> simp [hxy, hpair]
    linarith [hS3, hS2, hdiag, htriple, hcomb]
  have hoff_le : ∑ x : Fin n, ∑ y : Fin n,
      (if x ≠ y then
        (bvChebG2Unaug F ⟪(p x).val, (p y).val⟫ + ∑ k : Fin 16, c2 k * legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫)
      else 0) ≤ -((n : ℝ) * ((n : ℝ) - 1)) := by
    have hle : ∑ x : Fin n, ∑ y : Fin n,
        (if x ≠ y then
          (bvChebG2Unaug F ⟪(p x).val, (p y).val⟫ + ∑ k : Fin 16, c2 k * legendreP16 (k.val + 1) ⟪(p x).val, (p y).val⟫)
        else 0) ≤ ∑ x : Fin n, ∑ y : Fin n, if x ≠ y then (-1 : ℝ) else 0 := by
      refine Finset.sum_le_sum fun x _ => Finset.sum_le_sum fun y _ => ?_
      split_ifs with hxy
      · exact h2 _ (neg_one_le_inner (p x) (p y)) (hp x y hxy)
      · exact le_rfl
    have hcount : ∑ x : Fin n, ∑ y : Fin n, (if x ≠ y then (-1 : ℝ) else 0) = -((n : ℝ) * ((n : ℝ) - 1)) := by
      have hinner : ∀ x : Fin n, ∑ y : Fin n, (if x ≠ y then (-1 : ℝ) else 0) = -((n : ℝ) - 1) := by
        intro x
        have := Finset.add_sum_erase (Finset.univ : Finset (Fin n))
          (fun y => if x ≠ y then (-1 : ℝ) else 0) (Finset.mem_univ x)
        simp only [ne_eq, not_true_eq_false, ↓reduceIte, zero_add] at this
        rw [← this]
        have hcongr : ∑ y ∈ Finset.univ.erase x, (if x ≠ y then (-1 : ℝ) else 0) =
            ∑ _y ∈ Finset.univ.erase x, (-1 : ℝ) :=
          Finset.sum_congr rfl fun y hy => by simp [(Finset.mem_erase.mp hy).1.symm]
        rw [hcongr, Finset.sum_const, Finset.card_erase_of_mem (Finset.mem_univ x),
          Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
          Nat.cast_sub (Nat.pos_of_ne_zero hn), Nat.cast_one]
        ring
      simp_rw [hinner, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      ring
    linarith
  have hfinal : (n : ℝ) * ((n : ℝ) - 1) ≤
      (n : ℝ) * ((∑ i : Fin (d + 1), ∑ j : Fin (d + 1), F ⟨0, Nat.zero_lt_succ d⟩ i j) +
        ∑ k : Fin 16, c2 k) := by
    linarith
  nlinarith

end Geodesy.Spherical
