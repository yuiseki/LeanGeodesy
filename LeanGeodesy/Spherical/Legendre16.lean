    bvQ 5 u v (u * v + s) = 16 * s ^ 5 + (-20 : ℝ) * s ^ 3 * ((1 - u ^ 2) * (1 - v ^ 2)) + 5 * s * ((1 - u ^ 2) * (1 - v ^ 2)) ^ 2 := by
